+void Uc8279Driver::beginGrayscale(EpdBus& bus, const uint8_t* fb, GrayscaleMode mode, RefreshMode fallback,
+                                  bool turnOff) {
+  if (mode != GrayscaleMode::Absolute) {
+    displayGrayscaleBase(bus, fb, fallback, turnOff);
+    return;
+  }
+  // Absolute passes drive every pixel to its target level with the XTH4 bank,
+  // whatever state the pixel is in, and consume complete host planes. They need
+  // neither the B/W base frame nor the AA-pre settle pass that the weak
+  // differential nudge depends on - the base only exists to put particles in a
+  // known, receptive state for that nudge.
+  //
+  // Without this override the shared default ignores `mode` and runs the
+  // differential base anyway, so an absolute pass paid for two extra full-frame
+  // refreshes that are visible as a black frame and then an inverted one before
+  // the image appears.
+  //
+  // A revert is still required when the previous pass left the differential LUT
+  // and planes loaded; it is skipped after another absolute pass, so viewing
+  // images back to back costs one refresh each.
+  if (_inGrayscaleMode) grayscaleRevert(bus, fb);
+}
